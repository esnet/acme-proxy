      ],
      "options": {
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "fixedColor": "yellow", "mode": "fixed" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "none", "group": "A" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "mappings": []
        },
        "overrides": []
      }
    },

    {
      "id": 23,
      "type": "timeseries",
      "title": "Open File Descriptors",
      "description": "Number of open file descriptors held by the process.",
      "gridPos": { "x": 12, "y": 61, "w": 12, "h": 7 },
